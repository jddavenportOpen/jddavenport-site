{
  "buildCommand": "",
  "outputDirectory": ".",
  "framework": null,
  "redirects": [
    {
      "source": "/book",
      "destination": "https://book.jddavenport.com",
      "permanent": false
    },
    {
      "source": "/book.html",
      "destination": "https://book.jddavenport.com",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/teardown",
      "destination": "/teardown.html"
    },
    {
      "source": "/showcase",
      "destination": "/showcase.html"
    },
    {
      "source": "/brain",
      "destination": "/brain.html"
    },
    {
      "source": "/newsletter",
      "destination": "/newsletter.html"
    },
    {
      "source": "/api/confirm",
      "destination": "https://docs.agenttree.army/api/confirm"
    },
    {
      "source": "/api/unsubscribe",
      "destination": "https://docs.agenttree.army/api/unsubscribe"
    },
    {
      "source": "/downloads/:path*",
      "destination": "https://docs.agenttree.army/downloads/:path*"
    }
  ]
}
